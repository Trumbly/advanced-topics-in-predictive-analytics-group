"""Training skeleton for audio multi-label classification (Track B).

Fill in ONLY the `### MODEL ###` block. Input is (batch, 1, n_mels, time)
spectrograms; output is a logit per species of shape (batch, num_classes).
"""
from __future__ import annotations

import json
import os
from pathlib import Path

import torch
import torch.nn as nn

from lab.tasks.track_b_birdclef import load_audio_dataset


EPOCHS = int(os.environ.get("AGENT_EPOCHS", "1"))
BASE_BATCH_SIZE = int(os.environ.get("AGENT_BATCH_SIZE", "64"))
NUM_WORKERS = int(os.environ.get("AGENT_NUM_WORKERS", "4"))
DEVICE = os.environ.get("AGENT_DEVICE", "cpu")
# Learning-rate + schedule are the agent's main non-architectural levers.
# Both come from the proposal JSON via env vars; the skeleton clamps and
# whitelists them so a stray LR from the LLM can't blow up the run.
LR = float(os.environ.get("AGENT_LR", "1e-3"))
LR = min(max(LR, 1e-6), 1e-1)
LR_SCHEDULE = os.environ.get("AGENT_LR_SCHEDULE", "constant").strip().lower()
if LR_SCHEDULE not in {"constant", "cosine", "onecycle"}:
    LR_SCHEDULE = "constant"
LOG_EVERY_BATCHES = max(1, int(os.environ.get("AGENT_LOG_EVERY_BATCHES", "10")))
LOG_GPU_EVERY_BATCHES = max(
    1, int(os.environ.get("AGENT_LOG_GPU_EVERY_BATCHES", str(LOG_EVERY_BATCHES))),
)
ENABLE_GPU_UTIL_LOGS = os.environ.get("AGENT_LOG_GPU_UTIL", "1").lower() in {
    "1", "true", "yes", "on",
}

# Keep AGENT_BATCH_SIZE as the TOTAL batch for the DataLoader.
# Do NOT auto-scale by GPU count: multiplying the global batch often
# causes OOM / CUDA instability on smaller cards (e.g., T4).
_gpu_count = torch.cuda.device_count() if (DEVICE != "cpu" and torch.cuda.is_available()) else 0
ENABLE_DATA_PARALLEL = os.environ.get("AGENT_ENABLE_DATA_PARALLEL", "1").lower() in {
    "1", "true", "yes", "on",
}
MULTI_GPU = _gpu_count > 1 and ENABLE_DATA_PARALLEL
BATCH_SIZE = BASE_BATCH_SIZE


### MODEL ###
# The LLM writes a `build_model(num_classes: int) -> nn.Module` here.
### END MODEL ###


def train_one_epoch(model, loader, optimizer, loss_fn, device, *, epoch: int, scheduler=None):
    model.train()
    total, n = 0.0, 0
    try:
        total_batches = len(loader)
    except TypeError:
        total_batches = None

    # Per-batch loss trace so the UI can render a step-level curve —
    # especially useful when EPOCHS=1 (otherwise the epoch-level chart
    # is a single dot and tells you nothing about convergence shape).
    batch_losses: list[float] = []

    for batch_idx, (x, y) in enumerate(loader, start=1):
        x, y = x.to(device, non_blocking=True), y.to(device, non_blocking=True).float()
        optimizer.zero_grad(set_to_none=True)
        logits = model(x)
        loss = loss_fn(logits, y)
        loss.backward()
        optimizer.step()
        if scheduler is not None:
            scheduler.step()
        loss_val = float(loss.item())
        batch_losses.append(loss_val)
        total += loss_val * x.size(0)
        n += x.size(0)
        should_log = (
            batch_idx == 1
            or batch_idx % LOG_EVERY_BATCHES == 0
            or (total_batches is not None and batch_idx == total_batches)
        )
        if should_log:
            running_loss = total / max(n, 1)
            gpu_stats = ""
            should_log_gpu = (
                ENABLE_GPU_UTIL_LOGS
                and device != "cpu"
                and (
                    batch_idx == 1
                    or batch_idx % LOG_GPU_EVERY_BATCHES == 0
                    or (total_batches is not None and batch_idx == total_batches)
                )
            )
            if should_log_gpu:
                gpu_stats = _gpu_stats_line()
            gpu_suffix = f" | {gpu_stats}" if gpu_stats else ""
            if total_batches is not None:
                print(
                    f"[epoch {epoch}][batch {batch_idx}/{total_batches}] "
                    f"loss={loss_val:.4f} running_loss={running_loss:.4f}"
                    f"{gpu_suffix}",
                    flush=True,
                )
            else:
                print(
                    f"[epoch {epoch}][batch {batch_idx}] "
                    f"loss={loss_val:.4f} running_loss={running_loss:.4f}"
                    f"{gpu_suffix}",
                    flush=True,
                )
    return total / max(n, 1), batch_losses


def _gpu_stats_line() -> str:
    """Return a compact per-GPU util/memory string for live tuning."""
    if not torch.cuda.is_available():
        return ""
    try:
        parts = []
        util_fn = getattr(torch.cuda, "utilization", None)
        has_mem_get_info = hasattr(torch.cuda, "mem_get_info")
        for i in range(torch.cuda.device_count()):
            util_str = ""
            if callable(util_fn):
                try:
                    util = util_fn(i)
                    if isinstance(util, (int, float)):
                        util_str = f" util={float(util):.0f}%"
                except Exception:
                    util_str = ""

            mem_str = ""
            if has_mem_get_info:
                try:
                    free_b, total_b = torch.cuda.mem_get_info(i)
                    used_b = max(0, total_b - free_b)
                    used_mb = used_b / (1024 ** 2)
                    total_mb = total_b / (1024 ** 2)
                    used_pct = 100.0 * used_b / max(total_b, 1)
                    mem_str = f" mem={used_mb:.0f}/{total_mb:.0f}MiB ({used_pct:.0f}%)"
                except Exception:
                    mem_str = ""

            alloc_mb = torch.cuda.memory_allocated(i) / (1024 ** 2)
            reserved_mb = torch.cuda.memory_reserved(i) / (1024 ** 2)
            peak_mb = torch.cuda.max_memory_allocated(i) / (1024 ** 2)
            parts.append(
                f"gpu{i}{util_str}{mem_str} "
                f"alloc={alloc_mb:.0f}MiB reserved={reserved_mb:.0f}MiB "
                f"peak={peak_mb:.0f}MiB",
            )
        return " | ".join(parts)
    except Exception:
        return ""


@torch.no_grad()
def evaluate(model, loader, device):
    from sklearn.metrics import f1_score, roc_auc_score
    import numpy as np
    model.eval()
    ys, ps = [], []
    for x, y in loader:
        x = x.to(device, non_blocking=True)
        probs = torch.sigmoid(model(x)).cpu().numpy()
        ys.append(y.numpy())
        ps.append(probs)
    y = np.concatenate(ys, axis=0)
    p = np.concatenate(ps, axis=0)
    preds = (p > 0.5).astype(int)
    # ROC-AUC in multilabel is undefined for labels where y_true has only one
    # class in this validation slice (all 0 or all 1). Filter those labels out.
    # This avoids UndefinedMetricWarning spam and yields a stable "valid-only"
    # macro AUC.
    valid_mask = np.ptp(y, axis=0) > 0
    n_valid_labels = int(valid_mask.sum())
    n_total_labels = int(y.shape[1]) if y.ndim == 2 else 0
    if n_valid_labels > 0:
        try:
            roc_valid = float(
                roc_auc_score(y[:, valid_mask], p[:, valid_mask], average="macro"),
            )
        except Exception:
            roc_valid = 0.0
    else:
        roc_valid = 0.0
    return {
        "f1_macro": float(f1_score(y, preds, average="macro", zero_division=0)),
        # Keep the legacy key for compatibility; it now means "valid-only".
        "roc_auc_macro": roc_valid,
        "roc_auc_macro_valid_only": roc_valid,
        "n_valid_roc_labels": n_valid_labels,
        "n_total_roc_labels": n_total_labels,
        "loss": None,
    }


def main():
    train_loader, val_loader, num_classes = load_audio_dataset(
        batch_size=BATCH_SIZE, num_workers=NUM_WORKERS,
    )
    model = build_model(num_classes)
    # Continue-from-checkpoint: the orchestrator may inject a path to a
    # prior `best.pt` via AGENT_INIT_FROM_CHECKPOINT. Load with
    # strict=False so architecture tweaks (e.g. adding a head) don't
    # break the warm start. Missing file or key mismatch is logged, not
    # fatal — fallback is training from scratch.
    _init_ckpt = os.environ.get("AGENT_INIT_FROM_CHECKPOINT", "").strip()
    if _init_ckpt and os.path.isfile(_init_ckpt):
        try:
            _state = torch.load(_init_ckpt, map_location="cpu")
            _missing, _unexpected = model.load_state_dict(_state, strict=False)
            print(
                f"[skeleton] warm-start from {_init_ckpt}: "
                f"missing={len(_missing)} unexpected={len(_unexpected)}",
                flush=True,
            )
        except Exception as _e:
            print(f"[skeleton] warm-start failed, continuing from scratch: {_e!r}",
                  flush=True)
    elif _init_ckpt:
        print(f"[skeleton] AGENT_INIT_FROM_CHECKPOINT={_init_ckpt} not found; "
              "training from scratch", flush=True)
    model = model.to(DEVICE)
    if MULTI_GPU:
        # Known interaction: torchvision's StochasticDepth layer (used
        # inside EfficientNet/ConvNeXt blocks) produces a Bernoulli
        # noise tensor whose alignment depends on batch/channel dims,
        # which crashes with "CUDA error: misaligned address" when
        # DataParallel dispatches the scatter+replica forward. Disable
        # stochastic_depth before the DP wrap — costs a bit of
        # regularisation, buys a run that doesn't crash.
        _sd_disabled = 0
        for _m in model.modules():
            if _m.__class__.__name__ == "StochasticDepth":
                _m.p = 0.0
                _sd_disabled += 1
        if _sd_disabled:
            print(f"[skeleton] disabled {_sd_disabled} StochasticDepth layers "
                  "for DataParallel compat", flush=True)
        model = nn.DataParallel(model)
        print(
            f"[skeleton] DataParallel across {_gpu_count} GPUs. "
            f"total BATCH_SIZE={BATCH_SIZE} "
            f"LOG_EVERY_BATCHES={LOG_EVERY_BATCHES} "
            f"LOG_GPU_EVERY_BATCHES={LOG_GPU_EVERY_BATCHES}",
            flush=True,
        )
    else:
        if _gpu_count > 1 and not ENABLE_DATA_PARALLEL:
            print(
                f"[skeleton] {_gpu_count} GPUs visible; DataParallel disabled "
                f"(set AGENT_ENABLE_DATA_PARALLEL=1 to enable). "
                f"device={DEVICE} BATCH_SIZE={BATCH_SIZE} NUM_WORKERS={NUM_WORKERS} "
                f"LOG_EVERY_BATCHES={LOG_EVERY_BATCHES} "
                f"LOG_GPU_EVERY_BATCHES={LOG_GPU_EVERY_BATCHES}",
                flush=True,
            )
        else:
            print(
                f"[skeleton] device={DEVICE} BATCH_SIZE={BATCH_SIZE} "
                f"NUM_WORKERS={NUM_WORKERS} LOG_EVERY_BATCHES={LOG_EVERY_BATCHES} "
                f"LOG_GPU_EVERY_BATCHES={LOG_GPU_EVERY_BATCHES}",
                flush=True,
            )
    loss_fn = nn.BCEWithLogitsLoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=LR)

    # Scheduler selection. OneCycle steps per-iteration (needs
    # steps_per_epoch), the rest step per-epoch. The train loop already
    # yields to the scheduler via the optional kwarg.
    scheduler = None
    per_step_scheduler = False
    try:
        steps_per_epoch = len(train_loader)
    except TypeError:
        steps_per_epoch = None
    if LR_SCHEDULE == "cosine" and EPOCHS > 1:
        scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
            optimizer, T_max=EPOCHS,
        )
    elif LR_SCHEDULE == "onecycle" and steps_per_epoch:
        scheduler = torch.optim.lr_scheduler.OneCycleLR(
            optimizer,
            max_lr=LR,
            epochs=EPOCHS,
            steps_per_epoch=int(steps_per_epoch),
        )
        per_step_scheduler = True
    print(f"[skeleton] LR={LR:.2e} LR_SCHEDULE={LR_SCHEDULE}", flush=True)

    history = []
    best_score = float("-inf")
    ckpt_path = Path("best.pt")
    for epoch in range(1, EPOCHS + 1):
        loss, batch_losses = train_one_epoch(
            model, train_loader, optimizer, loss_fn, DEVICE, epoch=epoch,
            scheduler=scheduler if per_step_scheduler else None,
        )
        if scheduler is not None and not per_step_scheduler:
            scheduler.step()
        metrics = evaluate(model, val_loader, DEVICE)
        # Downsample very long batch traces so results.json doesn't blow
        # up — 500 points is enough to eyeball convergence shape in the UI.
        if len(batch_losses) > 500:
            _stride = max(1, len(batch_losses) // 500)
            batch_losses = batch_losses[::_stride]
        metrics.update(loss=loss, epoch=epoch, batch_losses=batch_losses)
        history.append(metrics)
        # Save the best weights so far so the orchestrator can archive
        # them and a later study can warm-start from here. Unwrap
        # DataParallel (save the inner module's state_dict, not the
        # replica) so loads round-trip on single-GPU kernels too.
        score = metrics.get("f1_macro")
        if isinstance(score, (int, float)) and score > best_score:
            best_score = float(score)
            _inner = model.module if isinstance(model, nn.DataParallel) else model
            try:
                torch.save(_inner.state_dict(), ckpt_path)
            except Exception as _e:
                print(f"[skeleton] checkpoint save failed: {_e!r}", flush=True)
        print(f"[epoch {epoch}] loss={loss:.4f} "
              f"f1_macro={metrics['f1_macro']:.4f} "
              f"roc_auc_macro={metrics['roc_auc_macro']:.4f} "
              f"roc_labels={metrics['n_valid_roc_labels']}/{metrics['n_total_roc_labels']}",
              flush=True)

    best = max(history, key=lambda h: h["f1_macro"])
    results = {
        "primary_metric": "f1_macro",
        "primary_score": best["f1_macro"],
        "history": history,
        "final": history[-1],
        "best": best,
        "checkpoint_path": str(ckpt_path) if ckpt_path.exists() else None,
    }
    Path("results.json").write_text(json.dumps(results, indent=2))


if __name__ == "__main__":
    main()
