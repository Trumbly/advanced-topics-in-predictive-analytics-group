from __future__ import annotations

import json
import os
from pathlib import Path

import torch
import torch.nn as nn
from torch.utils.data import DataLoader

from lab.tasks.track_a_disaster_tweets import load_text_dataset


EPOCHS = int(os.environ.get("AGENT_EPOCHS", "3"))
BATCH_SIZE = int(os.environ.get("AGENT_BATCH_SIZE", "64"))
NUM_WORKERS = int(os.environ.get("AGENT_NUM_WORKERS", "2"))
DEVICE = os.environ.get("AGENT_DEVICE", "cpu")


### MODEL ###
# The LLM writes a `build_model(vocab_size: int) -> nn.Module` here.
# The model must accept input of shape (batch, seq_len) (int64 token ids) and
# return a single logit per sample of shape (batch, 1) or (batch,).
### END MODEL ###


def train_one_epoch(model, loader, optimizer, loss_fn, device):
    model.train()
    total_loss, n = 0.0, 0
    for x, y in loader:
        x, y = x.to(device), y.to(device).float()
        optimizer.zero_grad()
        logits = model(x).squeeze(-1)
        loss = loss_fn(logits, y)
        loss.backward()
        optimizer.step()
        total_loss += loss.item() * x.size(0)
        n += x.size(0)
    return total_loss / max(n, 1)


@torch.no_grad()
def evaluate(model, loader, device):
    from sklearn.metrics import f1_score, roc_auc_score, accuracy_score
    model.eval()
    ys, ps = [], []
    for x, y in loader:
        x = x.to(device)
        logits = model(x).squeeze(-1)
        probs = torch.sigmoid(logits).cpu().numpy()
        ys.extend(y.numpy().tolist())
        ps.extend(probs.tolist())
    preds = [1 if p > 0.5 else 0 for p in ps]
    return {
        "f1_binary": float(f1_score(ys, preds)),
        "accuracy": float(accuracy_score(ys, preds)),
        "roc_auc_binary": float(roc_auc_score(ys, ps)),
        "loss": None,
    }


def main():
    train_loader, val_loader, vocab_size = load_text_dataset(
        batch_size=BATCH_SIZE,
        num_workers=NUM_WORKERS,
    )
    model = build_model(vocab_size).to(DEVICE)
    loss_fn = nn.BCEWithLogitsLoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)

    history = []
    for epoch in range(1, EPOCHS + 1):
        train_loss = train_one_epoch(model, train_loader, optimizer, loss_fn, DEVICE)
        metrics = evaluate(model, val_loader, DEVICE)
        metrics["loss"] = train_loss
        metrics["epoch"] = epoch
        history.append(metrics)
        print(f"[epoch {epoch}] loss={train_loss:.4f} "
              f"f1={metrics['f1_binary']:.4f} "
              f"acc={metrics['accuracy']:.4f} "
              f"roc_auc={metrics['roc_auc_binary']:.4f}",
              flush=True)

    best = max(history, key=lambda h: h["f1_binary"])
    results = {
        "primary_metric": "f1_binary",
        "primary_score": best["f1_binary"],
        "history": history,
        "final": history[-1],
        "best": best,
    }
    Path("results.json").write_text(json.dumps(results, indent=2))


if __name__ == "__main__":
    main()
