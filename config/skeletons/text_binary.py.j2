"""Training skeleton for text binary classification (Track A).

Fill in ONLY the `### MODEL ###` block with your proposed architecture.
Everything else is fixed and must not be modified.

This file is rendered into the sandbox as-is with the model block substituted
by the LLM's architecture proposal.
"""
from __future__ import annotations

import json
import os
from pathlib import Path

import torch
import torch.nn as nn
from torch.utils.data import DataLoader

from lab.tasks.track_a_disaster_tweets import load_text_dataset


EPOCHS = int(os.environ.get("AGENT_EPOCHS", "3"))
BATCH_SIZE = int(os.environ.get("AGENT_BATCH_SIZE", "64"))
NUM_WORKERS = int(os.environ.get("AGENT_NUM_WORKERS", "2"))
DEVICE = os.environ.get("AGENT_DEVICE", "cpu")
LR = float(os.environ.get("AGENT_LR", "1e-3"))
LR = min(max(LR, 1e-6), 1e-1)
LR_SCHEDULE = os.environ.get("AGENT_LR_SCHEDULE", "constant").strip().lower()
if LR_SCHEDULE not in {"constant", "cosine", "onecycle"}:
    LR_SCHEDULE = "constant"


### MODEL ###
# The LLM writes a `build_model(vocab_size: int) -> nn.Module` here.
# The model must accept input of shape (batch, seq_len) (int64 token ids) and
# return a single logit per sample of shape (batch, 1) or (batch,).
### END MODEL ###


def train_one_epoch(model, loader, optimizer, loss_fn, device, *, scheduler=None):
    model.train()
    total_loss, n = 0.0, 0
    for x, y in loader:
        x, y = x.to(device), y.to(device).float()
        optimizer.zero_grad()
        logits = model(x).squeeze(-1)
        loss = loss_fn(logits, y)
        loss.backward()
        optimizer.step()
        if scheduler is not None:
            scheduler.step()
        total_loss += loss.item() * x.size(0)
        n += x.size(0)
    return total_loss / max(n, 1)


@torch.no_grad()
def evaluate(model, loader, device):
    from sklearn.metrics import f1_score, roc_auc_score, accuracy_score
    model.eval()
    ys, ps = [], []
    for x, y in loader:
        x = x.to(device)
        logits = model(x).squeeze(-1)
        probs = torch.sigmoid(logits).cpu().numpy()
        ys.extend(y.numpy().tolist())
        ps.extend(probs.tolist())
    preds = [1 if p > 0.5 else 0 for p in ps]
    return {
        "f1_binary": float(f1_score(ys, preds)),
        "accuracy": float(accuracy_score(ys, preds)),
        "roc_auc_binary": float(roc_auc_score(ys, ps)),
        "loss": None,
    }


def main():
    train_loader, val_loader, vocab_size = load_text_dataset(
        batch_size=BATCH_SIZE,
        num_workers=NUM_WORKERS,
    )
    model = build_model(vocab_size)
    _init_ckpt = os.environ.get("AGENT_INIT_FROM_CHECKPOINT", "").strip()
    if _init_ckpt and os.path.isfile(_init_ckpt):
        try:
            _state = torch.load(_init_ckpt, map_location="cpu")
            _missing, _unexpected = model.load_state_dict(_state, strict=False)
            print(
                f"[skeleton] warm-start from {_init_ckpt}: "
                f"missing={len(_missing)} unexpected={len(_unexpected)}",
                flush=True,
            )
        except Exception as _e:
            print(f"[skeleton] warm-start failed, continuing from scratch: {_e!r}",
                  flush=True)
    elif _init_ckpt:
        print(f"[skeleton] AGENT_INIT_FROM_CHECKPOINT={_init_ckpt} not found; "
              "training from scratch", flush=True)
    model = model.to(DEVICE)
    loss_fn = nn.BCEWithLogitsLoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=LR)

    scheduler = None
    per_step_scheduler = False
    try:
        steps_per_epoch = len(train_loader)
    except TypeError:
        steps_per_epoch = None
    if LR_SCHEDULE == "cosine" and EPOCHS > 1:
        scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
            optimizer, T_max=EPOCHS,
        )
    elif LR_SCHEDULE == "onecycle" and steps_per_epoch:
        scheduler = torch.optim.lr_scheduler.OneCycleLR(
            optimizer,
            max_lr=LR,
            epochs=EPOCHS,
            steps_per_epoch=int(steps_per_epoch),
        )
        per_step_scheduler = True
    print(f"[skeleton] LR={LR:.2e} LR_SCHEDULE={LR_SCHEDULE}", flush=True)

    history = []
    best_score = float("-inf")
    ckpt_path = Path("best.pt")
    for epoch in range(1, EPOCHS + 1):
        train_loss = train_one_epoch(
            model, train_loader, optimizer, loss_fn, DEVICE,
            scheduler=scheduler if per_step_scheduler else None,
        )
        if scheduler is not None and not per_step_scheduler:
            scheduler.step()
        metrics = evaluate(model, val_loader, DEVICE)
        metrics["loss"] = train_loss
        metrics["epoch"] = epoch
        history.append(metrics)
        score = metrics.get("f1_binary")
        if isinstance(score, (int, float)) and score > best_score:
            best_score = float(score)
            try:
                torch.save(model.state_dict(), ckpt_path)
            except Exception as _e:
                print(f"[skeleton] checkpoint save failed: {_e!r}", flush=True)
        print(f"[epoch {epoch}] loss={train_loss:.4f} "
              f"f1={metrics['f1_binary']:.4f} "
              f"acc={metrics['accuracy']:.4f} "
              f"roc_auc={metrics['roc_auc_binary']:.4f}",
              flush=True)

    best = max(history, key=lambda h: h["f1_binary"])
    results = {
        "primary_metric": "f1_binary",
        "primary_score": best["f1_binary"],
        "history": history,
        "final": history[-1],
        "best": best,
        "checkpoint_path": str(ckpt_path) if ckpt_path.exists() else None,
    }
    Path("results.json").write_text(json.dumps(results, indent=2))


if __name__ == "__main__":
    main()
