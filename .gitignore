# Reports / bundles
reports/bundles/

# UI-spawned launches: records + logs live here. Local-only.
experiments/launches/

# UI-generated config backup
config/config.yaml.bak
config/*.yaml.bak

# Orchestrator runtime log — stays local
experiments/agent.log
docs/report/report.docx
